# Copy to .env.local for local development. All variables are optional.

# Public URL of the site (canonical links, social previews, sitemap).
# The GitHub Pages workflow sets this automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base path for the static GitHub Pages export (`npm run build:pages`).
# Default: /qr-code-studio. Use an empty value for a custom domain.
# The GitHub Pages workflow sets this automatically.
# PAGES_BASE_PATH=/qr-code-studio

# ---------------------------------------------------------------------------
# File uploads for the "File" QR type (Node.js server target only).
# Leave empty to disable uploads; linking to hosted files always works.
# These are SERVER-ONLY secrets. Never prefix them with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
SUPABASE_URL=
# Service-role key (legacy JWT) or a new secret key (sb_secret_…).
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=qr-files
# Maximum upload size in megabytes (default 10, capped at 50).
UPLOAD_MAX_MB=10
