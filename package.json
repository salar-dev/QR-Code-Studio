{
  "name": "qr-code-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Design, validate and export professional QR codes in the browser: 12 content types, full styling, scan verification and PNG/SVG/PDF/JPEG/WebP export.",
  "keywords": [
    "qr-code",
    "qr-code-generator",
    "qr-code-designer",
    "nextjs",
    "react",
    "typescript",
    "svg",
    "pdf"
  ],
  "homepage": "https://salar-dev.github.io/qr-code-studio/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salar-dev/qr-code-studio.git"
  },
  "bugs": {
    "url": "https://github.com/salar-dev/qr-code-studio/issues"
  },
  "author": "Wasalat Developer (https://github.com/salar-dev)",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "build:pages": "next build",
    "preview:pages": "node scripts/preview-pages.mjs",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:pages": "playwright test -c playwright.pages.config.ts",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "@zxing/library": "^0.23.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.55.0",
    "motion": "^14.1.0",
    "next": "16.4.0",
    "qr-code-styling": "^1.9.2",
    "qrcode-generator": "^1.5.2",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-colorful": "^5.8.1",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.4",
    "sonner": "^2.0.8",
    "svg2pdf.js": "^2.8.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
